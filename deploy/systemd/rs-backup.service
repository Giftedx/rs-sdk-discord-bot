# Daily backup of the secrets and the data of the bot. rs-backup.timer starts it.
# scripts/server-backup.sh has the restore steps.
# Root runs this unit. So it runs a root-owned copy of the script, not the file in
# /opt/rs-discord-bot, which rsbot can write. docs/running-the-bot.md, "Deploy scripts", shows
# how to install the copy. Install it again after each change to the script.
[Unit]
Description=Backup of rs-discord-bot secrets and data

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rs-server-backup
Nice=10
IOSchedulingClass=idle
PrivateTmp=yes
