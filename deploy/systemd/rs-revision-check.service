# Checks whether the game server serves a new client revision. rs-revision-check.timer
# starts it. A change logs "REVISION CHANGED": journalctl -u rs-revision-check
# On a change the script writes data/revision-restart. ExecStartPost= then restarts
# rs-gamelink.service with a fresh client. try-restart: only if the unit runs, so one-process
# mode (no gamelink) is not changed. The "+" prefix runs that line as root, without the
# limits below; it reads one fixed file and runs one fixed command. "$$" is a "$" for systemd.
[Unit]
Description=Check of the game server client revision
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rsbot
WorkingDirectory=/opt/rs-discord-bot
ExecStart=/opt/rs-discord-bot/scripts/server-revision-check.sh
ExecStartPost=+/bin/sh -c 'f=/opt/rs-discord-bot/data/revision-restart; if [ -e "$$f" ]; then rm -f "$$f"; systemctl try-restart rs-gamelink.service; fi'
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/rs-discord-bot/data
