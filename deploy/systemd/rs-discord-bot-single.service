# systemd unit of the Discord bot in one-process mode: the bot, the browser and the game tabs
# run in one process, with no rs-gamelink unit. rs-discord-bot.service is the unit for split
# mode. Install only one of the two.
# It loads three files of /opt/rs-discord-bot:
#   secrets/account.env  RS_ACCOUNT, RS_PASSWORD (from scripts/server-bootstrap.sh)
#   secrets/bot.env      DISCORD_TOKEN, DISCORD_CHANNEL_ID, ANTHROPIC_API_KEY and the bot settings
#   server.env           RS_CHROME_PATH (from scripts/server-bootstrap.sh)
# It does not set the box limits of the split unit. Chromium needs user namespaces
# (RestrictNamespaces=), /opt/rs-chrome (InaccessiblePaths=), the /proc files that are not
# per process (ProcSubset=pid) and the normal /dev (PrivateDevices=). Thus the jobs in this
# mode have fewer limits than in split mode.
[Unit]
Description=rs-sdk Discord bot (one-process mode)
After=network-online.target
Wants=network-online.target
Conflicts=rs-discord-bot.service rs-gamelink.service
OnFailure=rs-alert@%n.service
# A crash loop stops after 3 failed starts in 10 minutes, instead of going on for ever.
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=rsbot
WorkingDirectory=/opt/rs-discord-bot
ExecStart=/bin/bash -c 'set -a; . secrets/account.env; . secrets/bot.env; . server.env; set +a; exec /home/rsbot/.bun/bin/bun --no-env-file src/bot/main.ts'
Restart=on-failure
# More than 10 s, so that a new login does not follow the old session at once.
RestartSec=30
# The bot logs out of the game on SIGTERM; give it time.
TimeoutStopSec=40
KillMode=mixed
# The bot puts each job in a child cgroup of this unit, to limit its memory, tasks and CPU.
Delegate=yes
# No NoNewPrivileges=yes: the job runner uses sudo to run each job as the box user.
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/rs-discord-bot/data /home/rsbot/.cache
MemoryMax=3G

[Install]
WantedBy=multi-user.target
