# Install:
#   sudo install -m 644 deploy/systemd/rs-revision-check.service deploy/systemd/rs-revision-check.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now rs-revision-check.timer
[Unit]
Description=Daily check of the game server client revision

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
