# Reference list of the variables that the bot, gamelink and scripts/*.ts read.
# The scripts/server-*.sh files list their own overrides in their headers.
# You do not need a .env file: the local commands in README.md pass RS_ACCOUNT and RS_PASSWORD
# on the command line, and mode `local` of the scripts sets both URLs itself.
# If you do copy this file to .env, Bun loads it for every command in this directory,
# `bun test` included. Never put a real password in .env.
# For a remote game server: keep the account in secrets/account.env (docs/deploy-server.md)
# and load it in a subshell, only for the command that needs it (docs/development.md).
# Never commit a file that holds a real password. Git ignores .env and *.env.

# --- Read by src/shared/config.ts ---

# Account name. It must match ^[a-z0-9]{1,12}$. "prooflocal" is the example name of the local stack.
RS_ACCOUNT=prooflocal

# Game password, 1 to 20 characters. "x" is a dummy for the LOCAL STACK ONLY: the local
# stack has its login server off and accepts any password. Never put a real password here.
RS_PASSWORD=x

# Host of the game server. Default: rs-sdk.maxbittker.com (the rs-sdk demo world).
# Read "Be a good guest on the demo world" in README.md before you use the default.
# Example for your own server:
#RS_SERVER_HOST=game.example.org

# WebSocket URL of the rs-sdk gateway. The proxy sends the game password to this URL.
# Check the host and the scheme.
# Default: wss://<RS_SERVER_HOST>/gateway. Mode `local` uses ws://localhost:7780 and ignores
# this value. Example for your own server:
#RS_GATEWAY_URL=wss://game.example.org/gateway

# URL of the rs-sdk bot page. The game tab sends the game password to this URL.
# Check the host and the scheme.
# Default: https://<RS_SERVER_HOST>/bot. Mode `local` uses http://localhost:8888/bot and
# ignores this value. Example for your own server:
#RS_BOT_PAGE_URL=https://game.example.org/bot

# Client frame rate of the game tab, from 10 to 50 frames per second. Default: 15.
#RS_FPS=15

# Loopback port of the proxy, from 1 to 65535. Default: 7790.
#PROXY_PORT=7790

# Absolute path of the Chrome binary. Default: the Chrome that puppeteer downloaded.
# On a server, phase "chrome" of scripts/server-bootstrap.sh writes this value to server.env.
#RS_CHROME_PATH=/opt/rs-chrome/148.0.7778.97/chrome-linux64/chrome

# --- Read by the scripts ---

# Mode `demo` of the scripts in scripts/ refuses to run unless this value is 1.
# Mode `demo` logs in to a remote game server. Set this value only after the person who
# runs that server agreed. See docs/development.md.
#RS_ALLOW_DEMO=1

# Seconds that scripts/dev-stack.sh waits for each part of the local stack. Default: 1800.
#DEV_STACK_TIMEOUT_S=1800

# --- Read by the tests ---

# 1 skips the tests that launch Chromium. Job `check` of the CI workflow sets it.
# See docs/development.md.
#RS_SKIP_BROWSER_TESTS=1

# --- Read by puppeteer, not by the code of this repository ---

# 1 stops the Chrome download of `bun install`. The server bootstrap and job `check` of the
# CI workflow set it.
#PUPPETEER_SKIP_DOWNLOAD=1

# --- Not for you to set ---
# The scripts give the box stand-in (a child process) these variables: BOT_USERNAME, PASSWORD,
# GATEWAY_URL, SHOW_CHAT, AUTO_LAUNCH_BROWSER, TELEMETRY, PATH, HOME. In the child, PASSWORD
# holds the boot token of the proxy, not the game password. The scripts start the child with
# --no-env-file, so the child does not read a .env file.

# --- Read by the Discord bot (src/bot/config.ts). docs/running-the-bot.md has the full table. ---
# Keep these in secrets/bot.env, never in a tracked file.

# Bot token of your Discord application.
#DISCORD_TOKEN=
# The one channel where the bot listens and posts.
#DISCORD_CHANNEL_ID=123456789012345678
# Optional: only members with this role can give and stop instructions.
#DISCORD_ALLOWED_ROLE_ID=
# Anthropic API key. Read by @anthropic-ai/sdk.
#ANTHROPIC_API_KEY=
# Optional bearer token in place of the API key. Read by @anthropic-ai/sdk. The bot removes it
# from logs and from Discord text.
#ANTHROPIC_AUTH_TOKEN=
# Model, effort and spend limits. Defaults: claude-sonnet-5-5, medium, 25 turns, $2, 120 min, $30.
# The monthly cap is for all guilds; each guild gets an equal share. The daily allowance carries
# unused spend over to the next days. At 80% of the share or of the cap, the bot uses SMALL_MODEL
# and no escalation.
#AI_MODEL=claude-sonnet-5-5
#AI_EFFORT=medium
#AI_MAX_TURNS=25
#AI_MAX_INSTRUCTION_USD=2
# The wall-clock limit of one instruction, in minutes (1-1440).
#AI_MAX_INSTRUCTION_MIN=120
# The longest job, in minutes (1-60).
#AI_MAX_JOB_MIN=15
# UTC hour (0-23) of the daily notes review wake. Unset: no review.
#NOTES_REVIEW_HOUR_UTC=4
#AI_MONTHLY_CAP_USD=30
# The database bot.sqlite, and the saved scripts, notes and job files. Default: data
#DATA_DIR=data
# 0 turns off the reset of the 10-minute idle logout. Default: 1
#GAMELINK_IDLE_GUARD=1
#QUEUE_MAX=5
#USER_COOLDOWN_S=30
# Run each job as this Unix user through sudo. Set it on every server.
#BOX_USER=rsbox
#BOX_BUN_PATH=/usr/local/bin/bun
# 1 lets the bot start without BOX_USER. Jobs can then read the secrets of the bot. Local development only.
#BOT_ALLOW_UNSANDBOXED=1
# 1 lets every member of the channel give instructions when DISCORD_ALLOWED_ROLE_ID is not set.
#DISCORD_ALLOW_EVERYONE=1
# Several channels: a JSON list of {name, channelId, allowedRoleId or allowEveryone, account,
# passwordEnv, dataSubdir?, boxUser?}. With it, RS_ACCOUNT, RS_PASSWORD, DISCORD_CHANNEL_ID,
# DISCORD_ALLOWED_ROLE_ID and DISCORD_ALLOW_EVERYONE are not read. Each password comes from the
# variable that passwordEnv names, never from the file. Guild n (from 0) uses PROXY_PORT + n.
#GUILDS_FILE=secrets/guilds.json
# Day of the month (1-28) when the spend period starts. Default: 1
#SPEND_RESET_DAY=1
# The stronger model for the escalate tool and for trigger wakes (low HP, death).
# Default: claude-opus-5-5. "none" turns escalation off.
#ESCALATION_MODEL=claude-opus-5-5
# Minutes with no XP, position or inventory change before the watchdog stops a job. Default: 5
#WATCHDOG_MINUTES=5
# Limits of all jobs together, when the job cgroup is available (Delegate=yes).
#JOB_MEMORY_MB=1024
#JOB_PIDS=256
#JOB_CPU_PERCENT=100
# Milestone posts per hour and guild (0 turns them off), the UTC hour of the daily recap
# (unset: no recap), the name of the adventure log thread, and 0 to turn drawn cards off.
#DISCORD_POSTS_PER_HOUR=4
# The skill levels that get a main-channel post. Default: 10,25,50,75,90,99
#MILESTONE_LEVELS=10,25,50,75,90,99
#DISCORD_RECAP_HOUR_UTC=18
#DISCORD_LOG_THREAD=adventure-log
# The thread with pictures of deaths and level milestones. Must differ from the log thread.
#DISCORD_GALLERY_THREAD=gallery
# 1: no post notifies. 0: every post notifies. Unset: log and gallery silent, main posts notify.
#DISCORD_SILENT=
#DISCORD_CARDS=1
# The model that sorts channel messages and answers short questions. Default: claude-haiku-5-5
#SMALL_MODEL=claude-haiku-5-5
# 0 makes the bot answer only mentions and replies. Default: 1 (needs Message Content Intent)
#DISCORD_READ_ALL=1
# A private channel for the operator: one warning when a unit fails, at most once an hour.
# scripts/server-alert.sh reads it from the env file of the bot. Never the player channel.
# Unset: no Discord warning.
#ALERT_CHANNEL_ID=
# Split mode: the Unix socket of gamelink and the file that holds its token. With
# GAMELINK_SOCKET set, the bot talks to gamelink through the socket and starts no browser.
# gamelink needs GAMELINK_TOKEN_FILE. Default socket: /run/rs-gamelink/gamelink.sock
#GAMELINK_SOCKET=/run/rs-gamelink/gamelink.sock
#GAMELINK_TOKEN_FILE=

# --- Read by scripts/seed-check.ts only ---
#SEED_CHECK_MS=60000
#SEED_ONLY=walk-to,chop-and-bank
#SEED_DIR=seed

# --- Read by scripts/ai-check.ts only ---
# 1 sends the real SDK reference and prints the cache tokens of each turn (about $0.08).
#AI_CHECK_FULL=1
