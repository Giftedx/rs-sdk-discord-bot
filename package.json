{
  "name": "rs-sdk-discord-bot",
  "description": "Work in progress: a Discord bot that lets a channel direct an AI that plays one shared game account through rs-sdk.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "stack:start": "bash scripts/dev-stack.sh start",
    "stack:stop": "bash scripts/dev-stack.sh stop",
    "bot": "bun --no-env-file src/bot/main.ts"
  },
  "devDependencies": {
    "@types/bun": "~1.3.14",
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "discord.js": "^14.28.1",
    "puppeteer": "^24"
  }
}
