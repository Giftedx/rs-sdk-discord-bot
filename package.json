{
  "name": "rs-sdk-discord-bot",
  "description": "A Discord bot that lets a channel play one shared rs-sdk game account together, in plain words, through an AI agent.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "stack:start": "bash scripts/dev-stack.sh start",
    "stack:stop": "bash scripts/dev-stack.sh stop",
    "bot": "bun --no-env-file src/bot/main.ts"
  },
  "devDependencies": {
    "@types/bun": "~1.4.5",
    "typescript": "^7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "discord.js": "^14.28.1",
    "puppeteer": "^25"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
